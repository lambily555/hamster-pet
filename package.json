{
  "name": "momo-desktop-pet",
  "version": "1.4.0",
  "private": true,
  "description": "A tiny privacy-friendly hamster desktop companion",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "check": "node scripts/check-release.js",
    "dist": "node scripts/build.js && node scripts/check-release.js && electron-builder --win --x64 --publish never",
    "build": "node scripts/build.js",
    "test": "node scripts/test-ci.js"
  },
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.28.2"
  },
  "build": {
    "appId": "com.tuantuan.desktop.pet",
    "productName": "鼠鼠桌面小宠",
    "asar": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "scripts/process-custom-action.py",
      "package.json",
      "LICENSE",
      "ASSETS_LICENSE.md"
    ],
    "win": {
      "icon": "assets/mouse-real-icon-v2.ico",
      "target": [
        "portable",
        "nsis"
      ]
    },
    "portable": {
      "artifactName": "hamster-pet-portable-${version}.exe"
    },
    "nsis": {
      "artifactName": "hamster-pet-setup-${version}.exe",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "鼠鼠桌面小宠",
      "runAfterFinish": false
    }
  },
  "dependencies": {
    "three": "^0.185.1"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=11 <12"
  }
}
